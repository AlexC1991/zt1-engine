{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zt1-knowledge",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zt1-knowledge",
      "database_id": "8756422c-ee49-45e8-8031-e9bd281a443d",
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
