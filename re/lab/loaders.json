      "kind": "int",
      "key": 1,
      "dest": 2,
      "about": "an int key into a field or a global"
    },
    {
      "address": "0x4b486c",
      "kind": "string",
      "key": 1,
      "dest": 2,
      "about": "a string key"
    },
    {
      "address": "0x409c14",
      "kind": "int",
      "key": 1,
      "dest": 2,
      "about": "an int key (often into a local, then copied)"
    },
    {
