.vscode/
.claude/
build/
build_log.txt
runtime_log.txt
# pc-sync/ is intentionally tracked for sharing custom files between PCs
CMakeCache.txt
CMakeFiles/
__pycache__/
*.pyc
.idea/

# The Lab app (lab-app/): its packages, and what packing it leaves behind
lab-app/node_modules/
zt1-engine-lab.exe
zt1-engine-play.exe
lab-app/clangd/
lab-app/.lab-pack/
.cache/

# Releases (engine-build-resources/make_release.py): the x64 build and its zips
build-x64/
dist/

# Private reverse-engineering data (recordings, caches, private notes): never shared
re/private/

# The shared knowledge base (re/cloud/): wrangler's local state and its
# local secrets (.dev.vars holds the review token - never commit it)
re/cloud/.wrangler/
re/cloud/.dev.vars
re/cloud/node_modules/

# Not published yet: the tutorial-video tooling and the Lab design files
re/lab/video/
re/lab/design/

# The agent's own state (build state, memory, rag index): never shared
.voxai/

# Scratch output from checking CI runs by hand (never part of the engine)
/_jobs.*
/_log.*
/_run.*
/selectWrite-windows-build*.log
lab-app/_dev_*.py

# Private: how the official client is made - the installer (setup.exe), the
# release, packing and update-signing tooling, and the mod repository's client
# (kept in the private zt1-engine-build project on CodeRook). The open-source
# part is the engine; these stay on the release machine.
/installer/*
!/installer/.gitkeep
/engine-build-resources/make_release.py
/engine-build-resources/publish_release.py
/engine-build-resources/coderook_release.py
/engine-build-resources/pack_lab.py
/engine-build-resources/sign_engine_update.js
/engine-build-resources/sign_lab_update.js
/engine-build-resources/vendor_ghidra.py
/engine-build-resources/vendor_python.py
/engine-build-resources/ENGINE_UPDATES.md
/engine-build-resources/LAB_UPDATES.md
/.github/workflows/release.yml
/private/*
!/private/.gitkeep
/engine-build-resources/save_private.py
